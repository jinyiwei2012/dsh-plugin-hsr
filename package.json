{
  "name": "dsh-plugin-hsr",
  "version": "0.1.0",
  "description": "星穹铁道账号查询与遗器评分：DSH 插件",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "service/hsr",
    "service/tools",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "honkai-star-rail",
    "starrail",
    "artifact"
  ],
  "scripts": {
    "test": "python tests/test_artifact.py && python tests/test_render.py && python tests/test_artiscard.py && python tests/test_panelcard.py && python tests/test_htmlcard.py && python tests/test_mihomo.py && python tests/test_qrlogin.py && node --test tests/proxy.test.js",
    "serve": "python service/hsr/server.py",
    "bind": "python service/tools/bind_cookie.py",
    "qrlogin": "python service/tools/qr_login.py",
    "query": "python service/tools/query.py"
  },
  "engines": {
    "node": "^22.19.0 || >=24.2.0"
  }
}
